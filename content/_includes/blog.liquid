---
layout: main
---
<article class='note'>
  <header class='note-header'>
    {% if tags %}
      <nav class='post-tags' aria-label='Post tags'>
        {% for tag in tags -%}
          <a class='blog-filter' href='/blog/{{ tag | slugify }}/'>{{ tag }}</a>
        {%- endfor %}
      </nav>
    {% endif %}
    <h1>{{ title }}</h1>
    {% if publishDate %}
      <p class='note-date'>
        {% include 'post-date', postDate: publishDate %}
      </p>
    {% endif %}
  </header>
  <div class='prose'>{{ content }}</div>
</article>
