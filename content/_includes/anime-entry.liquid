<li class='anime-entry' data-type='{{ entry.type | escape }}' data-favorite='{{ entry.favorite }}'>
  <div class='anime-entry__main'>
    <div class='anime-entry__title'>
      <strong>{{ entry.title | escape }}</strong>
      {% if entry.favorite %}
        <span class='favorite-heart' role='img' aria-label='Favorite'>
          <svg viewBox='0 0 24 24' aria-hidden='true' focusable='false'>
            <path d='M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z' />
          </svg>
        </span>
      {% endif %}
    </div>
    {% if entry.notes != blank %}
      <p class='anime-note'>{{ entry.notes | escape }}</p>
    {% endif %}
  </div>
  <span class='anime-entry__type'>
    {% if entry.type == 'series' %}
      SEASON
    {% elsif entry.type == 'film' %}
      MOVIE
    {% else %}
      {{ entry.type | upcase | escape }}
    {% endif %}
  </span>
</li>
