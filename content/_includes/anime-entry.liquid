<li class='anime-entry'>
  <div class='anime-entry__main'>
    <div class='anime-entry__title'>
      <strong>{{ entry.title | escape }}</strong>
      {% if entry.favorite %}
        {% include 'favorite-heart' %}
      {% endif %}
    </div>
  </div>
  <span class='anime-entry__type'>
    {% if entry.type == 'series' %}
      SEASON
    {% elsif entry.type == 'film' %}
      MOVIE
    {% else %}
      {{ entry.type | upcase | escape }}
    {% endif %}
  </span>
</li>
