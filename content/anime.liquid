---
title: Anime — Dixita Ganatra
layout: main
pagination:
  data: collections.listings.anime
  size: 1
  alias: listing
permalink: '{{ listing.url }}'
eleventyExcludeFromCollections: true
eleventyComputed:
  title: 'Anime — {{ listing.label }} — Dixita Ganatra'
---
<article class='page content-list anime-page'>
  <header class='page-header'>
    <h1>Anime I’m watching / have watched.</h1>
    <p>
      I mostly watch anime in Japanese, but I prefer the English dub when I want something to watch
      casually while doing something else.
    </p>
  </header>

  {% include 'filter-nav',
    options: collections.listings.anime,
    navClass: 'anime-filters',
    navLabel: 'Filter anime'
  %}
  {% assign watching = listing.items | where: 'watching', true %}
  {% assign watched = listing.items | where: 'watching', false %}
  {% assign watched_years = watched | groupByYear | entriesByNewestYear %}
  {% if listing.items.size == 0 and listing.key != 'all' %}
    <p class='anime-empty'>No titles in this view yet.</p>
  {% endif %}
  <div class='anime-sections'>
    {% if watching.size > 0 or listing.key == 'all' %}
      <section aria-labelledby='watching-heading'>
        <h2 class='content-section-heading' id='watching-heading'>Watching now</h2>
        {% if watching.size > 0 %}
          <ul class='anime-list'>
            {% for entry in watching %}
              {% include 'anime-entry' %}
            {% endfor %}
          </ul>
        {% else %}
          <p class='anime-empty'>Nothing here just yet.</p>
        {% endif %}
      </section>
    {% endif %}
    {% if watched.size > 0 or listing.key == 'all' %}
      <section aria-labelledby='watched-heading'>
        <div class='anime-archive__heading'>
          <h2 class='content-section-heading' id='watched-heading'>Watched</h2>
        </div>
        {% if watched.size > 0 %}
          {% for year_titles in watched_years %}
            {% assign titles = year_titles[1] %}
            <section class='anime-year' aria-labelledby='anime-year-{{ year_titles[0] }}'>
              <h3 id='anime-year-{{ year_titles[0] }}'>{{ year_titles[0] }}</h3>
              <ul class='anime-list'>
                {% for entry in titles %}
                  {% include 'anime-entry' %}
                {% endfor %}
              </ul>
            </section>
          {% endfor %}
        {% else %}
          <p class='anime-empty'>The collection is on its way.</p>
        {% endif %}
      </section>
    {% endif %}
  </div>
</article>
