---
permalink: /rss.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
{% assign latestPost = collections.posts | first %}
<feed xmlns='http://www.w3.org/2005/Atom'>
  <title>{{ site.title | escape }}</title>
  <subtitle>{{ site.description | escape }}</subtitle>
  <link href='{{ site.url }}/rss.xml' rel='self' />
  <link href='{{ site.url }}/' />
  <id>{{ site.url }}/</id>
  <updated>{{ latestPost.data.publishDate | date: '%Y-%m-%dT00:00:00Z' }}</updated>
  <author>
    <name>{{ site.title | escape }}</name>
  </author>
  {% for post in collections.posts -%}
    <entry>
      <title>{{ post.data.title | escape }}</title>
      <link href='{{ site.url }}{{ post.url }}' />
      <id>
        {{- site.url -}}
        {{- post.url -}}
      </id>
      <updated>{{ post.data.publishDate | date: '%Y-%m-%dT00:00:00Z' }}</updated>
    </entry>
  {%- endfor %}
</feed>
